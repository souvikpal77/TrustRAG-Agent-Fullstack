# =============================================================================
# TrustRAG-Agent – environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All values below are consumed server-side by FastAPI / SQLAlchemy / Gemini.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Comma separated list of allowed browser origins (frontend dev + docker nginx)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# --- PostgreSQL -------------------------------------------------------------
# Local zero-install alternative (no PostgreSQL required):
#   DATABASE_URL=sqlite+aiosqlite:///./trustrag_dev.db
#   AUTO_CREATE_SCHEMA=true
POSTGRES_USER=trustrag
POSTGRES_PASSWORD=trustrag_dev_password
POSTGRES_DB=trustrag
# Async driver is mandatory for the FastAPI runtime.
DATABASE_URL=postgresql+asyncpg://trustrag:trustrag_dev_password@localhost:5432/trustrag
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Create tables on boot when migrations have not been applied (dev convenience).
# Keep false in production and run `alembic upgrade head` instead.
AUTO_CREATE_SCHEMA=false

# --- Google Gemini ----------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
# GEMINI_API_KEY is accepted as an alias for GOOGLE_API_KEY.
GOOGLE_API_KEY=
# Ordered fallback chain. The first model that answers wins.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
# When no API key is configured, produce a clearly labelled extractive answer
# instead of failing (useful for local UI smoke testing). Set false in prod.
ALLOW_OFFLINE_LLM_FALLBACK=true

# --- Embeddings -------------------------------------------------------------
# "hashing" = deterministic, dependency-free local embeddings (default).
# "gemini"  = text embeddings via the Gemini API (requires GOOGLE_API_KEY).
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSIONS=384
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Chunking ---------------------------------------------------------------
CHUNK_SIZE=1400
CHUNK_OVERLAP=220
CHUNK_MIN_SIZE=200

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_DEFAULT_TOP_K=8
RETRIEVAL_SEMANTIC_WEIGHT=0.6
RETRIEVAL_BM25_K1=1.5
RETRIEVAL_BM25_B=0.75
RETRIEVAL_MAX_CANDIDATES=20000

# --- Trust engine -----------------------------------------------------------
TRUST_WEIGHT_PROVENANCE=0.15
TRUST_WEIGHT_AUTHORITY=0.15
TRUST_WEIGHT_RELEVANCE=0.20
TRUST_WEIGHT_ENTAILMENT=0.20
TRUST_WEIGHT_FRESHNESS=0.10
TRUST_WEIGHT_MODEL_CONFIDENCE=0.20
TRUST_ABSTAIN_THRESHOLD=40
TRUST_REVIEW_THRESHOLD=65

# --- Verification -----------------------------------------------------------
ENTAILMENT_SUPPORT_THRESHOLD=0.55
ENTAILMENT_CONTRADICTION_THRESHOLD=0.45
MAX_CLAIMS_PER_ANSWER=15

# --- Ingestion / limits -----------------------------------------------------
MAX_UPLOAD_MB=25
SEED_MITRE=true

# --- Frontend (build-time) --------------------------------------------------
# Leave empty to use the Vite dev proxy / nginx reverse proxy at /api.
VITE_API_BASE_URL=
